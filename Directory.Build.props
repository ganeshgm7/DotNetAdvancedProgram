<Project>
  <!-- 
    Directory.Build.props - Shared build properties for all projects
    This file is automatically imported by MSBuild for all projects in subdirectories.
    https://docs.microsoft.com/en-us/visualstudio/msbuild/customize-your-build
  -->

  <PropertyGroup>
    <!-- Enable .NET analyzers for all projects -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    
    <!-- Set analysis level to recommended (less strict than 'latest-all') -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    
    <!-- Enable code analysis on build -->
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    
    <!-- Enforce code style on build (IDE* rules) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    
    <!-- Enable nullable reference types for better null safety -->
    <Nullable>enable</Nullable>
    
    <!-- Suppress common warnings that are too strict for learning projects -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1515;CA2007;CA1062;CA1031</NoWarn>
  </PropertyGroup>

  <!-- Suppress certain warnings for test projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- CA1707: Identifiers should not contain underscores (test methods often use underscores) -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- CA1812: Avoid uninstantiated internal classes (test classes are often internal) -->
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>

</Project>
